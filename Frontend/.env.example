# CacheX Frontend Environment Configuration
# In production on Render (Static Site), set this to your Backend Web Service URL:
# Example: VITE_API_BASE_URL=https://cachex-api.onrender.com
#
# In local development, you can leave it empty to use the Vite local proxy (/api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=
