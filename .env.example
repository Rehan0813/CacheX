# ============================================================
# CacheX - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ============================================================

# Database Configuration
# Leave blank or omit to automatically use local SQLite (zero-config)
DATABASE_URL=
# Or for MySQL:
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_HOST=localhost
MYSQL_DB=cachex

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional custom model path override
MODEL_PATH=
